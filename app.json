{
  "expo": {
    "name": "앗차공-뽀모도로",
    "slug": "atchagong",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./src/assets/images/Ice.png",
    "scheme": "atchagongapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atchagong.atchagong",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F3FC",
        "backgroundImage": "./src/assets/images/Background.png",
        "foregroundImage": "./src/assets/images/Ice.png"
      },
      // "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.atchagong.app"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/Ice.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/Penguin1.png",
          "resizeMode": "contain",
          "backgroundColor": "#E8F3FC"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.761978560648-0crl7jk5r8jq9u5828525d6j5tdp846n"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "4f6fff7cfa092fbcd26c100a1826c6d1"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af6077a3-64d4-4a2d-a311-45b17015fd17"
      }
    },
    "owner": "atchagong"
  }
}
