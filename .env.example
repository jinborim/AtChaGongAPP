# 백엔드 서버 주소
EXPO_PUBLIC_API_BASE_URL=

# Google OAuth
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# Kakao native login
# Native app key is configured in app.json through @react-native-seoul/kakao-login.

# 개발 테스트 유저 정보
# 주의: EXPO_PUBLIC_ 값은 앱 번들에 포함될 수 있으므로 개발용으로만 사용한다.
EXPO_PUBLIC_DEV_AUTH_ACCESS_TOKEN=
EXPO_PUBLIC_DEV_AUTH_REFRESH_TOKEN=
EXPO_PUBLIC_DEV_AUTH_ONBOARDING_COMPLETED=false
